<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke file sensitif (.env, .git, dll)
    RewriteRule "(^|/)\.(?!well-known)" - [F]
    RewriteRule "\.(env|sql|bak|log|git|md|yml|yaml|json)$" - [F]

    # Jangan rewrite jika request sudah ada di dalam public/ atau mengakses public langsung
    RewriteCond %{REQUEST_URI} (public/|public$) [NC]
    RewriteRule ^ - [L]

    # Jika belum ada public/, arahkan request ke folder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

